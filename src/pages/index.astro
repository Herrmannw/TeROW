---
import { Image } from "astro:assets";
import heroTractor from "../assets/images/commercial/commercial-tractor-transport.jpg";
import tractMowing from "../assets/images/commercial/commercial-tract-mowing.jpg";
import ditchMowing from "../assets/images/commercial/commercial-ditch-mowing.jpg";
import batwingMowing from "../assets/images/commercial/commercial-batwing-mowing.jpg";
import pondMowing from "../assets/images/commercial/commercial-pond-mowing.jpg";
import commercialFleet from "../assets/images/commercial/commercial-fleet.jpg";
import flowerBed from "../assets/images/flower-bed.jpg";
import gardenWalkway from "../assets/images/garden-walkway.jpg";
import {
  allServices,
  business,
  featuredServices,
  galleryItems,
  marketsServed,
  processSteps,
  serviceArea,
} from "../data/site";
import "../styles/global.css";

const pageTitle = "Commercial Landscaping & Land Management | TeROW Houston";
const description =
  "Commercial landscaping and land management across Greater Houston, including grounds maintenance, tractor mowing, land clearing, irrigation, landscape installation, and exterior site improvements.";
const publicAsset = (fileName: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${fileName.replace(/^\/+/, "")}`;
const ogImage = new URL("og.png", business.url).toString();
const galleryImages = [
  ditchMowing,
  batwingMowing,
  pondMowing,
  commercialFleet,
  flowerBed,
  gardenWalkway,
];
const serviceOptions = featuredServices.map((service) => service.title);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b4129" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href={publicAsset("favicon.png")} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="utility-bar">
      <div class="container utility-bar__inner">
        <p>Commercial land management across Greater Houston</p>
        <div class="utility-bar__links">
          <span>Mon–Fri 7–6 · Sat 8–4</span>
          <a href={`tel:${business.phoneHref}`}>{business.phoneDisplay}</a>
        </div>
      </div>
    </div>

    <header class="site-header" data-header>
      <div class="container site-header__inner">
        <a class="brand" href="#top" aria-label={`${business.shortName} home`}>
          <img
            src={publicAsset("terow-logo.png")}
            alt="TeROW Land Management Services"
            width="1436"
            height="584"
          />
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-nav"
          data-menu-toggle
        >
          <span class="menu-toggle__icon" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
          <span data-menu-label>Menu</span>
        </button>

        <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation" data-nav>
          <a href="#markets">Markets</a>
          <a href="#services">Services</a>
          <a href="#work">Work</a>
          <a href="#coverage">Coverage</a>
          <a href="#contact">Contact</a>
        </nav>

        <a class="button button--small header-cta" href="#contact">
          Request a Site Assessment <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" id="top">
        <div class="container hero__grid">
          <div class="hero__copy">
            <p class="eyebrow">
              <span aria-hidden="true"></span>
              Commercial landscaping & land management · Greater Houston
            </p>
            <h1>Commercial grounds, <em>managed from curb to acreage.</em></h1>
            <p class="hero__intro">
              TeROW supports commercial facilities, municipalities, MUDs,
              HOAs, retail centers, logistics sites, and large properties with
              dependable grounds, mowing, clearing, irrigation, and site work.
            </p>
            <div class="hero__actions">
              <a class="button" href="#contact">
                Request a Site Assessment <span aria-hidden="true">→</span>
              </a>
              <a class="button button--ghost" href={`tel:${business.phoneHref}`}>
                Call {business.phoneDisplay}
              </a>
            </div>
            <ul class="hero__trust" aria-label="Business highlights">
              <li><span aria-hidden="true">✓</span> Fully insured</li>
              <li><span aria-hidden="true">✓</span> Commercial-grade equipment</li>
              <li><span aria-hidden="true">✓</span> English & Spanish</li>
            </ul>
          </div>

          <div class="hero__visual">
            <div class="hero__image-frame">
              <Image
                src={heroTractor}
                alt="TeROW commercial tractor secured on a transport trailer and ready to mobilize"
                widths={[640, 960, 1280]}
                sizes="(max-width: 860px) 100vw, 50vw"
                format="webp"
                quality={84}
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="hero__badge">
              <span class="hero__badge-mark" aria-hidden="true">T</span>
              <p><strong>Site-ready</strong><br />equipment capability</p>
            </div>
            <p class="hero__caption">Commercial grounds · Acreage mowing · Site services</p>
          </div>
        </div>
      </section>

      <section class="proof-strip" aria-label="Company information">
        <div class="container proof-strip__grid">
          <div class="proof-item">
            <strong>{business.experience}</strong>
            <span>land management experience</span>
          </div>
          <div class="proof-item">
            <strong>Commercial + public sector</strong>
            <span>property programs</span>
          </div>
          <div class="proof-item">
            <strong>Large-site capability</strong>
            <span>tractors and batwing mowing</span>
          </div>
          <div class="proof-item">
            <strong>{business.languages}</strong>
            <span>responsive coordination</span>
          </div>
        </div>
      </section>

      <section class="section markets" id="markets">
        <div class="container">
          <div class="section-heading section-heading--compact">
            <p class="eyebrow">
              <span aria-hidden="true"></span>
              Markets we serve
            </p>
            <h2>Built for public, commercial, and community properties.</h2>
          </div>

          <ul class="market-grid">
            {
              marketsServed.map((market) => (
                <li>
                  <span aria-hidden="true"></span>
                  <strong>{market}</strong>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section services" id="services">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">
              <span aria-hidden="true"></span>
              Commercial capabilities
            </p>
            <h2>The equipment and expertise to maintain property <em>at scale.</em></h2>
          </div>

          <div class="service-grid">
            {
              featuredServices.map((service) => (
                <article class="service-card">
                  <h3>{service.title}</h3>
                  <p>{service.description}</p>
                  <a href="#contact">
                    Request a Site Assessment <span aria-hidden="true">→</span>
                  </a>
                </article>
              ))
            }
          </div>

          <div class="service-catalog">
            <div class="service-catalog__heading">
              <p class="overline">Complete capability list</p>
              <h3>One partner for the site.</h3>
              <p>
                Scope recurring maintenance, specialized mowing, landscape
                improvements, and multi-location work around your operational needs.
              </p>
            </div>
            <ul>
              {
                allServices.map((service) => (
                  <li>
                    <span aria-hidden="true">+</span>
                    {service}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="section approach">
        <div class="container approach__grid">
          <div class="approach__visual">
            <Image
              src={tractMowing}
              alt="TeROW tractor mowing an expansive commercial tract beside a curb"
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 860px) 100vw, 46vw"
              format="webp"
              quality={82}
              loading="lazy"
            />
            <div class="approach__note">
              <span aria-hidden="true">“</span>
              <p>Built for acreage, access, and recurring service schedules.</p>
            </div>
          </div>

          <div class="approach__copy">
            <p class="eyebrow eyebrow--light">
              <span aria-hidden="true"></span>
              How we work
            </p>
            <h2>Clear scope. Reliable scheduling. Accountable work.</h2>
            <p class="approach__intro">
              Commercial property care starts with a practical understanding
              of access, acreage, conditions, stakeholders, and service
              expectations. We turn those needs into a clear plan for the site.
            </p>
            <ol class="process-list">
              {
                processSteps.map((step) => (
                  <li>
                    <span>{step.number}</span>
                    <div>
                      <h3>{step.title}</h3>
                      <p>{step.description}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section class="section gallery" id="work">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">
              <span aria-hidden="true"></span>
              Field capability
            </p>
            <h2>Commercial capability, proven <em>in the field.</em></h2>
          </div>

          <div class="gallery-grid">
            {
              galleryItems.map((item, index) => (
                <figure class={`gallery-card gallery-card--${index + 1}`}>
                  <Image
                    src={galleryImages[index]}
                    alt={item.alt}
                    widths={[480, 720, 960, 1200]}
                    sizes={
                      index === 0 || index === 5
                        ? "(max-width: 720px) 100vw, 66vw"
                        : "(max-width: 720px) 100vw, 34vw"
                    }
                    format="webp"
                    quality={82}
                    loading="lazy"
                  />
                  {item.sample && <small class="gallery-card__sample">Sample imagery</small>}
                  <figcaption>
                    <span>{item.subtitle}</span>
                    <strong>{item.title}</strong>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section service-area" id="coverage">
        <div class="container">
          <div class="service-area__top">
            <p class="eyebrow eyebrow--light">
              <span aria-hidden="true"></span>
              Greater Houston coverage
            </p>
            <h2>Serving commercial properties across Greater Houston.</h2>
          </div>

          <div class="area-layout">
            <div class="area-map" aria-label="Illustrated Greater Houston coverage region">
              <span class="area-map__ring area-map__ring--outer"></span>
              <span class="area-map__ring area-map__ring--inner"></span>
              <div class="area-map__center">
                <span class="area-map__pin" aria-hidden="true"></span>
                <strong>{serviceArea.primary}</strong>
                <small>Regional operations</small>
              </div>
              <span class="area-map__city area-map__city--katy">Katy</span>
              <span class="area-map__city area-map__city--cypress">Cypress</span>
              <span class="area-map__city area-map__city--pearland">Pearland</span>
              <span class="area-map__city area-map__city--sugar">Sugar Land</span>
            </div>

            <div class="area-details">
              <div class="area-details__cities">
                <p class="overline">Regional coverage</p>
                <ul>
                  <li>{serviceArea.primary}</li>
                  {serviceArea.nearby.map((city) => <li>{city}</li>)}
                  <li>Surrounding communities</li>
                </ul>
              </div>
              <dl>
                <div>
                  <dt>Coverage area</dt>
                  <dd>{serviceArea.region}</dd>
                </div>
                <div>
                  <dt>Account structure</dt>
                  <dd>{serviceArea.siteTypes}</dd>
                </div>
                <div>
                  <dt>Engagements</dt>
                  <dd>{serviceArea.engagementTypes}</dd>
                </div>
                <div>
                  <dt>Project planning</dt>
                  <dd>{serviceArea.coverage}</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </section>

      <section class="section contact" id="contact">
        <div class="container">
          <div class="contact-shell">
            <div class="contact-intro">
              <p class="eyebrow">
                <span aria-hidden="true"></span>
                Request a Site Assessment
              </p>
              <h2>Let’s walk the site and scope the work.</h2>
              <p>
                Share the property, priorities, service frequency, and
                procurement needs. We will review the opportunity and coordinate
                a practical next step for your organization.
              </p>

              <div class="contact-details">
                <a href={`tel:${business.phoneHref}`}>
                  <span>Call us</span>
                  <strong>{business.phoneDisplay}</strong>
                </a>
                <a href={`mailto:${business.email}`}>
                  <span>Email us</span>
                  <strong>{business.email}</strong>
                </a>
              </div>

              <div class="contact-assurance">
                <span aria-hidden="true">✓</span>
                <p>
                  <strong>A focused first step for the property.</strong>
                  We will use your details to prepare for a useful site discussion.
                </p>
              </div>
            </div>

            <div class="form-panel">
              <form id="site-assessment-form" novalidate data-assessment-form>
                <div class="form-heading">
                  <div>
                    <p class="overline">Commercial site-assessment request</p>
                    <h3>Tell us about the property</h3>
                  </div>
                  <span>Fields marked * are required</span>
                </div>

                <div
                  class="form-summary"
                  id="form-summary"
                  role="alert"
                  tabindex="-1"
                  hidden
                ></div>

                <div class="form-grid form-grid--two">
                  <div class="field">
                    <label for="full-name">Contact name *</label>
                    <input
                      id="full-name"
                      name="fullName"
                      type="text"
                      autocomplete="name"
                      required
                      aria-describedby="full-name-error"
                    />
                    <p class="field-error" id="full-name-error"></p>
                  </div>
                  <div class="field">
                    <label for="organization">Organization or company *</label>
                    <input
                      id="organization"
                      name="organization"
                      type="text"
                      autocomplete="organization"
                      required
                      aria-describedby="organization-error"
                    />
                    <p class="field-error" id="organization-error"></p>
                  </div>
                </div>

                <div class="form-grid form-grid--two">
                  <div class="field">
                    <label for="property-type">Client or property type *</label>
                    <select
                      id="property-type"
                      name="propertyType"
                      required
                      aria-describedby="property-type-error"
                    >
                      <option value="">Choose a property type</option>
                      {
                        marketsServed.map((market) => (
                          <option value={market}>{market}</option>
                        ))
                      }
                    </select>
                    <p class="field-error" id="property-type-error"></p>
                  </div>
                  <div class="field">
                    <label for="service">Primary service needed *</label>
                    <select
                      id="service"
                      name="service"
                      required
                      aria-describedby="service-error"
                    >
                      <option value="">Choose a service</option>
                      {
                        serviceOptions.map((service) => (
                          <option value={service}>{service}</option>
                        ))
                      }
                      <option value="Recurring commercial maintenance">Recurring commercial maintenance</option>
                      <option value="Multi-site maintenance">Multi-site maintenance</option>
                      <option value="Something else">Something else</option>
                    </select>
                    <p class="field-error" id="service-error"></p>
                  </div>
                </div>

                <div class="form-grid form-grid--two">
                  <div class="field">
                    <label for="site-size">Approximate acreage or site size</label>
                    <input
                      id="site-size"
                      name="siteSize"
                      type="text"
                      placeholder="Example: 12 acres or 3 locations"
                    />
                  </div>
                  <div class="field">
                    <label for="engagement-type">Engagement type</label>
                    <select id="engagement-type" name="engagementType">
                      <option value="Not sure">Not sure yet</option>
                      <option value="Recurring maintenance">Recurring maintenance</option>
                      <option value="One-time project">One-time project</option>
                      <option value="Bid/RFP">Bid/RFP</option>
                    </select>
                  </div>
                </div>

                <div class="form-grid form-grid--two">
                  <div class="field">
                    <label for="phone">Phone number</label>
                    <input
                      id="phone"
                      name="phone"
                      type="tel"
                      inputmode="tel"
                      autocomplete="tel"
                      placeholder="832-692-4434"
                      aria-describedby="contact-method-error"
                    />
                  </div>
                  <div class="field">
                    <label for="email">Email address</label>
                    <input
                      id="email"
                      name="email"
                      type="email"
                      inputmode="email"
                      autocomplete="email"
                      placeholder="name@organization.com"
                      aria-describedby="contact-method-error"
                    />
                  </div>
                </div>
                <p class="field-error field-error--group" id="contact-method-error"></p>

                <div class="form-grid form-grid--two">
                  <div class="field">
                    <label for="contact-preference">Preferred contact</label>
                    <select id="contact-preference" name="contactPreference">
                      <option value="Phone">Phone call</option>
                      <option value="Text">Text message</option>
                      <option value="Email">Email</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for="location">Site city or address *</label>
                    <input
                      id="location"
                      name="location"
                      type="text"
                      autocomplete="street-address"
                      placeholder="Houston, TX"
                      required
                      aria-describedby="location-error"
                    />
                    <p class="field-error" id="location-error"></p>
                  </div>
                </div>

                <div class="field">
                  <label for="project-details">Site and scope details *</label>
                  <textarea
                    id="project-details"
                    name="projectDetails"
                    rows="6"
                    minlength="20"
                    required
                    placeholder="Share the acreage or site size, number of locations, current conditions, desired service frequency, deadline, and any procurement requirements."
                    aria-describedby="project-details-hint project-details-error"
                  ></textarea>
                  <div class="field-meta">
                    <span id="project-details-hint">A few operational details help us prepare.</span>
                    <span data-character-count>0 / 20 minimum</span>
                  </div>
                  <p class="field-error" id="project-details-error"></p>
                </div>

                <label class="consent">
                  <input
                    id="consent"
                    name="consent"
                    type="checkbox"
                    required
                    aria-describedby="consent-error"
                  />
                  <span>
                    I agree that TeROW may contact me about this site-assessment request. *
                  </span>
                </label>
                <p class="field-error" id="consent-error"></p>

                <button class="button form-submit" type="submit">
                  Request a Site Assessment <span aria-hidden="true">→</span>
                </button>
                <p class="form-disclaimer">
                  Demo mode: this form validates your details but does not send,
                  store, or transmit them.
                </p>
              </form>

              <div class="form-success" role="status" tabindex="-1" hidden data-form-success>
                <span class="form-success__mark" aria-hidden="true">✓</span>
                <p class="overline">Commercial request validated</p>
                <h3>Your site-assessment request is ready.</h3>
                <p>
                  The form is working in demo mode. Your commercial request was
                  validated, but it was not transmitted or saved. Connect a form
                  service before the public launch.
                </p>
                <button class="button button--ghost" type="button" data-form-reset>
                  Start another request
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__top">
          <div class="footer-brand">
            <img
              src={publicAsset("terow-logo.png")}
              alt="TeROW Land Management Services"
              width="1436"
              height="584"
              loading="lazy"
            />
            <p>
              Commercial landscaping and land management for public,
              commercial, industrial, retail, HOA, and large-acreage properties
              across Greater Houston.
            </p>
          </div>

          <div class="footer-column">
            <p class="overline">Contact</p>
            <a href={`tel:${business.phoneHref}`}>{business.phoneDisplay}</a>
            <a href={`mailto:${business.email}`}>{business.email}</a>
            <a href="#contact">Request a Site Assessment</a>
          </div>

          <div class="footer-column">
            <p class="overline">Hours</p>
            {business.hours.map((line) => <span>{line}</span>)}
          </div>

          <div class="footer-column">
            <p class="overline">Follow & review</p>
            <a href={business.social.facebook} target="_blank" rel="noreferrer">
              Facebook <span aria-hidden="true">↗</span>
            </a>
            <a href={business.social.instagram} target="_blank" rel="noreferrer">
              Instagram <span aria-hidden="true">↗</span>
            </a>
            <a href={business.social.reviews} target="_blank" rel="noreferrer">
              Google reviews <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="site-footer__bottom">
          <p>© <span data-current-year></span> {business.name}. All rights reserved.</p>
          <p>{business.credentials}</p>
          <p class="demo-note">Demonstration content · Replace before launch</p>
        </div>
      </div>
    </footer>

    <div class="mobile-actions" aria-label="Quick contact">
      <a href={`tel:${business.phoneHref}`}>Call now</a>
      <a href="#contact">Request a Site Assessment</a>
    </div>

    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
      const nav = document.querySelector<HTMLElement>("[data-nav]");
      const menuLabel = document.querySelector<HTMLElement>("[data-menu-label]");

      const closeMenu = () => {
        menuToggle?.setAttribute("aria-expanded", "false");
        nav?.removeAttribute("data-open");
        if (menuLabel) menuLabel.textContent = "Menu";
      };

      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        nav?.toggleAttribute("data-open", !isOpen);
        if (menuLabel) menuLabel.textContent = isOpen ? "Menu" : "Close";
      });

      nav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
          menuToggle?.focus();
        }
      });

      document.querySelectorAll("[data-current-year]").forEach((element) => {
        element.textContent = String(new Date().getFullYear());
      });

      const form = document.querySelector<HTMLFormElement>("[data-assessment-form]");
      const success = document.querySelector<HTMLElement>("[data-form-success]");
      const resetButton = document.querySelector<HTMLButtonElement>("[data-form-reset]");
      const summary = document.querySelector<HTMLElement>("#form-summary");
      const details = document.querySelector<HTMLTextAreaElement>("#project-details")!;
      const characterCount = document.querySelector<HTMLElement>("[data-character-count]");

      const setError = (
        input: HTMLElement | null,
        message: string,
        errorId: string,
      ) => {
        const error = document.querySelector<HTMLElement>(`#${errorId}`);
        input?.setAttribute("aria-invalid", "true");
        input?.closest(".field")?.setAttribute("data-invalid", "");
        if (error) error.textContent = message;
      };

      const clearError = (input: HTMLElement | null, errorId: string) => {
        const error = document.querySelector<HTMLElement>(`#${errorId}`);
        input?.removeAttribute("aria-invalid");
        input?.closest(".field")?.removeAttribute("data-invalid");
        if (error) error.textContent = "";
      };

      const updateCharacterCount = () => {
        if (details && characterCount) {
          characterCount.textContent = `${details.value.length} / 20 minimum`;
        }
      };

      details?.addEventListener("input", updateCharacterCount);

      const validateForm = () => {
        if (!form) return [];
        const invalid: HTMLElement[] = [];
        const fullName = form.querySelector<HTMLInputElement>("#full-name")!;
        const organization = form.querySelector<HTMLInputElement>("#organization")!;
        const propertyType = form.querySelector<HTMLSelectElement>("#property-type")!;
        const service = form.querySelector<HTMLSelectElement>("#service")!;
        const location = form.querySelector<HTMLInputElement>("#location")!;
        const phone = form.querySelector<HTMLInputElement>("#phone")!;
        const email = form.querySelector<HTMLInputElement>("#email")!;
        const consent = form.querySelector<HTMLInputElement>("#consent")!;

        clearError(fullName, "full-name-error");
        clearError(organization, "organization-error");
        clearError(propertyType, "property-type-error");
        clearError(service, "service-error");
        clearError(location, "location-error");
        clearError(details, "project-details-error");
        clearError(consent, "consent-error");
        clearError(phone, "contact-method-error");
        clearError(email, "contact-method-error");

        if (!fullName?.value.trim()) {
          setError(fullName, "Please enter the contact name.", "full-name-error");
          invalid.push(fullName);
        }
        if (!organization?.value.trim()) {
          setError(
            organization,
            "Please enter the organization or company.",
            "organization-error",
          );
          invalid.push(organization);
        }
        if (!propertyType?.value) {
          setError(
            propertyType,
            "Please choose a client or property type.",
            "property-type-error",
          );
          invalid.push(propertyType);
        }
        if (!service?.value) {
          setError(service, "Please choose a primary service.", "service-error");
          invalid.push(service);
        }

        const phoneValue = phone?.value.trim() ?? "";
        const emailValue = email?.value.trim() ?? "";
        const emailValid = !emailValue || email?.validity.valid;
        const phoneDigits = phoneValue.replace(/\D/g, "");
        const phoneValid = !phoneValue || phoneDigits.length >= 10;

        if (!phoneValue && !emailValue) {
          setError(phone, "Enter a phone number or email address.", "contact-method-error");
          email?.setAttribute("aria-invalid", "true");
          invalid.push(phone);
        } else if (!phoneValid) {
          setError(phone, "Enter a phone number with at least 10 digits.", "contact-method-error");
          invalid.push(phone);
        } else if (!emailValid) {
          setError(email, "Enter a valid email address.", "contact-method-error");
          invalid.push(email);
        }

        if (!location?.value.trim()) {
          setError(location, "Please enter the site city or address.", "location-error");
          invalid.push(location);
        }
        if (!details?.value.trim() || details.value.trim().length < 20) {
          setError(
            details,
            "Please share at least 20 characters about the site and scope.",
            "project-details-error",
          );
          invalid.push(details);
        }
        if (!consent?.checked) {
          setError(consent, "Please agree before continuing.", "consent-error");
          invalid.push(consent);
        }

        return invalid;
      };

      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        const invalid = validateForm();

        if (invalid.length > 0) {
          if (summary) {
            summary.textContent = `Please review ${invalid.length} ${
              invalid.length === 1 ? "field" : "fields"
            } and try again.`;
            summary.hidden = false;
          }
          invalid[0]?.focus();
          return;
        }

        if (summary) summary.hidden = true;
        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.focus();
        }
      });

      resetButton?.addEventListener("click", () => {
        form?.reset();
        updateCharacterCount();
        if (success) success.hidden = true;
        if (form) form.hidden = false;
        if (summary) summary.hidden = true;
        form?.querySelector<HTMLInputElement>("#full-name")?.focus();
      });
    </script>
  </body>
</html>
